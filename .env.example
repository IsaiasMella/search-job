# ---------------------------------------------------------------------------
# vacantia — las claves de esta computadora.
#
# No hace falta copiar ni editar este archivo a mano: se cargan desde la
# pantalla (abrir.bat > Mi perfil > Claves), que crea el .env sola.
# Todo es opcional: sin claves el programa corre igual, pero recorta lo que hace.
# ---------------------------------------------------------------------------

# El modelo que puntúa las ofertas contra el CV — https://aistudio.google.com
# Sin esto el puntaje es una heurística por palabras que no sirve para decidir.
GEMINI_API_KEY="tu_gemini_api_key_aca"

# Leer páginas de empleo, portales y publicaciones — https://agent.tinyfish.ai
# Sin esto se saltean las empresas, los reclutadores, Bumeran, Zonajobs y Computrabajo.
TINYFISH_API_KEY="tu_tinyfish_api_key_aca"

# Avisos por Telegram — el bot se crea con @BotFather.
# El chat de cada persona NO va acá: se carga en su perfil, en "Mi Telegram".
# TELEGRAM_CHAT_ID es sólo el chat de reserva para un perfil que no tenga uno.
TELEGRAM_TOKEN="tu_telegram_bot_token_aca"
TELEGRAM_CHAT_ID=""

# --- Opcionales -----------------------------------------------------------
# Plan B del modelo, con "provider": "openrouter" en el perfil. Techo de 50 llamadas por día.
# OPENROUTER_API_KEY="tu_openrouter_api_key_aca"
# LOG_LEVEL="DEBUG"                  # detalle por oferta en vacantia.log
