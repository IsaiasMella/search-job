# ---------------------------------------------------------------------------
# vacantia — copiá este archivo a .env y completá lo que tengas.
# Todo es opcional: sin credenciales el motor igual corre de punta a punta
# (usa la fuente dummy y/o imprime por consola).
# ---------------------------------------------------------------------------

# LLM para el scoring — free tier en https://openrouter.ai
# Sin esto el scoring cae a una heurística por keywords.
OPENROUTER_API_KEY="tu_openrouter_api_key_aca"

# Lectura de careers pages — https://agent.tinyfish.ai
# Sin esto se saltea la fuente 'careers'.
TINYFISH_API_KEY="tu_tinyfish_api_key_aca"

# Notificación por Telegram — creá el bot con @BotFather
# Sin esto los resultados se imprimen por consola.
TELEGRAM_TOKEN="tu_telegram_bot_token_aca"
TELEGRAM_CHAT_ID="tu_telegram_chat_id_aca"

# --- Opcionales -----------------------------------------------------------
# OPENROUTER_MODEL="meta-llama/llama-3.3-70b-instruct:free"
# OPENROUTER_FALLBACK_MODELS="nvidia/nemotron-3-super-120b-a12b:free,qwen/qwen3-coder:free"
# LLM_PROVIDER="claude_cli"          # usa el login local de Claude Code, sin API key
# ANTHROPIC_API_KEY="..."            # con llm.provider = "anthropic"
# LOG_LEVEL="DEBUG"                  # detalle por oferta en consola
