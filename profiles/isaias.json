{
  "name": "isaias",
  "cv_path": "resume/isaias.md",
  "keywords": [
    "AI engineer",
    "Python"
  ],
  "min_score": 60,
  "top_n": 5,
  "max_new_per_run": 30,
  "notify_when_empty": false,
  "filters": {
    "location": {
      "country": "Argentina",
      "city": ""
    },
    "work_modes": [
      "remote"
    ],
    "language": {
      "allow_english": false,
      "max_english_level": "A2",
      "scan_description": true
    }
  },
  "report": {
    "english_pain": true
  },
  "candidate": {
    "name": "Isaías",
    "profile": "Perfil de datos / IA. Stack: Python, SQL, ML, LLMs.",
    "seeking": "Trabajo 100% remoto desde Argentina. Vive en Bahía Blanca.",
    "not_suitable": "Puestos junior, roles no técnicos, puestos presenciales o híbridos fuera de Bahía Blanca, y cualquier puesto que requiera inglés",
    "relocation_note": "No se reubica ni viaja. Bahía Blanca o remoto.",
    "search_seniority": "",
    "search_keywords": ""
  },
  "llm": {
    "provider": "gemini",
    "gemini_api_key": "${GEMINI_API_KEY}",
    "model": "gemini-2.5-flash-lite",
    "fallback_models": [
      "gemini-flash-lite-latest",
      "gemini-2.5-flash"
    ],
    "openrouter_api_key": "${OPENROUTER_API_KEY}"
  },
  "sources": [
    {
      "type": "careers",
      "enabled": true,
      "companies_file": "companies.json",
      "api_key": "${TINYFISH_API_KEY}",
      "use_search": true,
      "max_companies": null
    },
    {
      "type": "google_posts",
      "enabled": true,
      "provider": "tinyfish",
      "language": "es",
      "roles": [
        "AI Engineer",
        "Machine Learning Engineer",
        "Data Scientist",
        "MLOps Engineer",
        "LLM Engineer",
        "GenAI Engineer"
      ],
      "max_queries": 4,
      "results_per_query": 10
    },
    {
      "type": "linkedin",
      "enabled": true,
      "search_terms": [
        "AI Engineer",
        "Machine Learning Engineer",
        "Data Scientist",
        "MLOps Engineer",
        "LLM Engineer"
      ],
      "locations": [
        "Argentina"
      ],
      "is_remote": true,
      "results_wanted": 25,
      "hours_old": 168,
      "fetch_description": true,
      "delay_between_searches": 5,
      "max_searches": 3
    },
    {
      "type": "dummy",
      "enabled": false
    }
  ],
  "notifiers": [
    {
      "type": "telegram",
      "enabled": true,
      "token": "${TELEGRAM_TOKEN}",
      "chat_id": "${TELEGRAM_CHAT_ID}"
    },
    {
      "type": "console",
      "enabled": true
    }
  ]
}
