{
  "name": "isaias",
  "cv_path": "resume/isaias.md",
  "keywords": [
    "AI engineer",
    "Python"
  ],
  "min_score": 60,
  "top_n": 5,
  "max_new_per_run": 30,
  "notify_when_empty": true,
  "filters": {
    "max_age_days": 7,
    "location": {
      "country": "Argentina",
      "city": "Bahía Blanca"
    },
    "work_modes": [
      "remote"
    ],
    "language": {
      "allow_english": false,
      "max_english_level": "A2",
      "scan_description": true
    },
    "excluir_titulos": [
      "Machine Learning",
      "MLOps",
      "Data Scientist",
      "Data Science",
      "Data Steward",
      "Data Engineer",
      "Data Governance",
      "Data Analyst",
      "Custodio",
      "Deep Learning",
      "Computer Vision",
      "Quality Assurance",
      "QA Automation",
      "Power BI",
      "Big Data",
      "Científico de Datos",
      "Analista de Datos"
    ]
  },
  "report": {
    "english_pain": true
  },
  "candidate": {
    "name": "Isaías",
    "profile": "AI Engineer: conecto modelos ya entrenados (OpenAI, LLMs open source) a producto. RAG, function calling, agentes y APIs con Python y FastAPI.",
    "seeking": "Trabajo 100% remoto desde Argentina. Vive en Bahía Blanca.",
    "not_suitable": "NO entrena modelos ni construye redes neuronales: conecta modelos ya entrenados a producto. Por eso NO sirven los puestos de Machine Learning Engineer, Data Scientist, MLOps, Deep Learning, Computer Vision ni nada que pida entrenar, hacer fine-tuning o armar arquitecturas de modelos. Tampoco: puestos junior, roles no técnicos, presenciales o híbridos fuera de Bahía Blanca, ni nada que requiera inglés.",
    "relocation_note": "No se reubica ni viaja. Bahía Blanca o remoto.",
    "search_seniority": "",
    "search_keywords": "",
    "headline": "AI Engineer"
  },
  "llm": {
    "provider": "gemini",
    "gemini_api_key": "${GEMINI_API_KEY}",
    "model": "gemini-3.5-flash-lite",
    "fallback_models": [
      "gemini-flash-lite-latest",
      "gemini-3.6-flash"
    ],
    "openrouter_api_key": "${OPENROUTER_API_KEY}"
  },
  "sources": [
    {
      "type": "careers",
      "enabled": true,
      "companies_file": "companies.json",
      "api_key": "${TINYFISH_API_KEY}",
      "use_search": true,
      "max_companies": null
    },
    {
      "type": "google_posts",
      "enabled": true,
      "provider": "tinyfish",
      "language": "es",
      "roles": [
        "AI Engineer",
        "LLM Engineer",
        "GenAI Engineer",
        "AI Agent Engineer",
        "Backend Python",
        "Prompt Engineer"
      ],
      "max_queries": 4,
      "results_per_query": 10
    },
    {
      "type": "linkedin",
      "enabled": true,
      "search_terms": [
        "AI Engineer",
        "LLM Engineer",
        "GenAI Engineer",
        "AI Agent Engineer",
        "Backend Python"
      ],
      "locations": [
        "Argentina"
      ],
      "is_remote": true,
      "results_wanted": 25,
      "hours_old": 168,
      "fetch_description": true,
      "delay_between_searches": 5,
      "max_searches": 3
    },
    {
      "type": "dummy",
      "enabled": false
    },
    {
      "type": "rrhh",
      "enabled": true,
      "profiles": [
        "https://www.linkedin.com/in/renzo-bazan-reyna-247214182/recent-activity/all/"
      ]
    },
    {
      "type": "bumeran",
      "enabled": false
    },
    {
      "type": "zonajobs",
      "enabled": true
    },
    {
      "type": "computrabajo",
      "enabled": true
    }
  ],
  "notifiers": [
    {
      "type": "telegram",
      "enabled": true,
      "token": "${TELEGRAM_TOKEN}",
      "chat_id": "${TELEGRAM_CHAT_ID}"
    },
    {
      "type": "console",
      "enabled": true
    }
  ]
}
